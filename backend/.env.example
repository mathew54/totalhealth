NODE_ENV=development
PORT=4000

# == Modo MOCK (data ficticia en memoria, sin Supabase) ==
# Con USE_MOCK=true el backend no usa Supabase y expone credenciales demo.
USE_MOCK=true

# Supabase (proyecto + service role key para operaciones de servicio).
# Si USE_MOCK=false y no defines estas, la app usa el mock de todos modos.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=TU_JWT_SECRET

# Token del portal público (firma propia, independiente de Supabase)
PORTAL_TOKEN_SECRET=cambia-esto-por-un-secreto-fuerte
PORTAL_TOKEN_TTL_MIN=30

# Opciones
CORS_ORIGIN=http://localhost:5173
OTC_MAX_INTENTOS=5

# == Cifrado en reposo (campos sensibles) ==
# AES-256-GCM app-layer sobre `profiles.telefono`/`firma_digital` y
# `pacientes.telefono`. Sin la clave, los campos viajan en claro (dev/mock).
# En producción genera una clave fuerte y NO la pierdas (irrecuperable).
FIELD_ENCRYPTION_KEY=

# == Bloqueo por intentos fallidos de login ==
# LOGIN_MAX_INTENTOS=5   (intentos fallidos antes de bloquear)
# LOGIN_LOCK_MIN=15      (minutos de bloqueo al superar los intentos)

# == Proveedores de pago ==
# PAYMENT_PROVIDER=mock    (dev) o pasarela (Banesco/BDV pago móvil, Zelle)
PAYMENT_PROVIDER=mock

# == Notificador (OTP y recordatorios) ==
# MESSAGING_PROVIDER=mock  (dev, expone el contenido para probar)
# MESSAGING_PROVIDER=smtp  (real: correo SMTP; Twilio para SMS/WhatsApp)
MESSAGING_PROVIDER=mock
SMTP_ENABLED=false
SMTP_HOST=smtp.tu_proveedor.com
SMTP_USER=tu_usuario
SMTP_PASS=tu_password
SMTP_FROM=Laboratorio TotalHealth <no-reply@totalhealth.example>

# == Tasas de cambio (scraping BCV) ==
# URL pública del Banco Central de Venezuela para extraer USD/EUR del día.
# BCV_URL=https://www.bcv.org.ve/